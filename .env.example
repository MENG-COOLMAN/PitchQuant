# ============================================================
#  Football Odds Analysis Model — 环境变量模板
#  用法: cp .env.example .env  然后填入你自己的 key
#  🔴 .env 已被 .gitignore 排除，切勿提交真实密钥
# ============================================================

# ---- 数据源密钥（必填·二选一或都填）----
# Odds-API（欧盘赔率·主数据源）: https://odds-api.io
ODDS_API_KEY=your_odds_api_key_here

# api-football（官方概率 / 13家赔率 / 伤停）: https://www.api-football.com
API_FOOTBALL_KEY=your_api_football_key_here

# ---- 本地代理（可选·如 Clash/V2Ray 默认端口）----
# 部分数据源（新闻抓取 / 欧盘）在部分网络环境下需要代理
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897

# ---- 历史数据库（可选·仅回测脚本需要）----
SQL_PATH=data/football-api.sql
