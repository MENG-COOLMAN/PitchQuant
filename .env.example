# ============================================================
#  PitchQuant — 环境变量模板
#  用法: cp .env.example .env  然后填入你自己的 key
#  🔴 .env 已被 .gitignore 排除，切勿提交真实密钥
#  🔴 无 key 的运行方式见 docs/data-and-apis.md（多数脚本支持离线/三态降级）
# ============================================================

# ---- 数据源密钥 ----
# Odds-API（欧盘赔率 · 赛事定位 · 主数据源）: https://odds-api.io
ODDS_API_KEY=your_odds_api_key_here

# the-odds-api（21–40 家机构 · 跨市场分歧 + 亚盘多档 + BTTS）: https://the-odds-api.com
# 免费档 500 请求/月；historical 需付费（免费档返回 HISTORICAL_UNAVAILABLE_ON_FREE_USAGE_PLAN）
THE_ODDS_API_KEY=your_the_odds_api_key_here
# 可选：key 池（用尽自动轮转）——逗号分隔
# THE_ODDS_API_POOL=key1,key2

# Bzzoiro Sports Data（结构化伤停 / 名单 / Form5 · 伤停唯一源）: https://bzzoiro.com
BZZOIRO_KEY=your_bzzoiro_key_here

# 智谱 GLM（可选 · 仅「截图 → 赔率文本」用）: https://open.bigmodel.cn
ZHIPU_API_KEY=your_zhipu_api_key_here

# ⚠️ api-football 已于 2026-10 停用并从数据链剔除
#    赔率 → the-odds-api ｜ 伤停 → Bzzoiro ｜ 赛事定位 → Odds-API
#    官方概率 / 首发阵容 → 无替代（三态标注）

# ---- 本地代理（可选·如 Clash/V2Ray 默认端口）----
# 注意：Odds-API 实测「代理优先」比直连快约 400 倍（直连 SSL 握手常 24s+）
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897

# ---- 历史数据库（可选·仅回测脚本需要）----
SQL_PATH=data/football-api.sql
# Matches.csv（22.7 万场）不随仓库分发，回测脚本将其路径指向本地副本即可
MATCHES_CSV=data/Matches.csv
